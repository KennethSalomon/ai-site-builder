# Copiez ce fichier vers `.env` et renseignez vos valeurs.

# --- Moteur IA par défaut : Gemini (free tier, aucune carte) ---
# Clé d'API gratuite Google AI Studio (https://aistudio.google.com/apikey).
# Modèle par défaut du free tier : flash (nécessaire ; le "flash-lite" n'est
# plus proposé aux comptes récents). Si absente, le moteur bascule sur un
# fallback déterministe par secteur (aucune génération IA).
GEMINI_API_KEY=
# Modèle Gemini (optionnel, défaut : gemini-2.5-flash).
GEMINI_MODEL=gemini-2.5-flash
# Provider explicite (optionnel) : gemini | grok. Sans valeur, la détection
# choisit le provider dont la clé est présente (Gemini prioritaire).
LLM_PROVIDER=gemini

# --- Hébergement des productions (optionnel mais recommandé) ---
# Jeton d'API Vercel (https://vercel.com/account/tokens). Active la mise en
# ligne réelle des sites générés : chaque production est deployée chez Vercel
# le hébergeur par défaut (https://{projet}.vercel.app). Sans jeton, la mise
# en ligne renvoie une erreur explicite.
# Requis aussi pour `npm run vercel:deploy` : le jeton injecte les clés IA de
# ce fichier dans le projet Vercel (sinon aucune IA ne tourne en production).
VERCEL_TOKEN=

# --- Alternative : Grok (xAI) — requiert des crédits (optionnel) ---
# Clé d'API xAI (https://console.x.ai), OpenAI-compatible. Utilisée
# uniquement si GEMINI_API_KEY est absent et LLM_PROVIDER=grok|xai.
XAI_API_KEY=
# Modèle Grok (optionnel, défaut : grok-3).
LLM_MODEL=grok-3
