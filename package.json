{
  "name": "guardsite-ai",
  "description": "GuardSite AI — générateur de sites vitrines professionnels par IA.",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
