[
  {
    "id": "metric-card",
    "category": "dashboard_module",
    "framework": "TailwindCSS",
    "name": "Carte métrique",
    "description": "Carte de suivi d'un indicateur clé (libellé, valeur, statut, tendance).",
    "keywords": ["kpi", "metrique", "indicateur", "statistique", "chiffre", "revenue", "revenu"],
    "sectors": ["Commerciale", "Services", "Electronique"],
    "html_code": "<div class='rounded-xl border border-slate-200 bg-white p-5 shadow-sm'> <div class='flex items-center justify-between'> <span class='text-sm font-medium text-slate-500'>{{TITLE}}</span> <span class='rounded-full px-2 py-0.5 text-xs font-medium {{STATUS_CLASS}}'>{{STATUS}}</span> </div> <p class='mt-2 text-3xl font-semibold text-slate-900'>{{METRIC_VALUE}}</p> <p class='mt-1 text-xs text-slate-400'>{{DELTA}}</p> </div>",
    "variables_attendues": ["title", "metric_value", "status", "status_class", "delta"]
  },
  {
    "id": "progress-card",
    "category": "dashboard_module",
    "framework": "TailwindCSS",
    "name": "Carte de progression",
    "description": "Barre de progression avec libellé et pourcentage.",
    "keywords": ["progression", "progress", "avancement", "barre", "objectif", "objectif"],
