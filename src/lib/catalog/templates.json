    "html_code": "<li class='flex items-center gap-3 rounded-lg px-3 py-3 hover:bg-slate-50'> <span class='grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-slate-100 text-base'>{{ICON}}</span> <span class='min-w-0 flex-1'> <span class='block truncate text-sm font-medium text-slate-900'>{{TITLE}}</span> <span class='block truncate text-xs text-slate-400'>{{TIME}}</span> </span> <span class='shrink-0 rounded-full px-2 py-0.5 text-xs font-medium {{STATUS_CLASS}}'>{{STATUS}}</span> </li>",
    "variables_attendues": ["icon", "title", "time", "status", "status_class"]
  },
  {
    "id": "contact-form",
    "category": "form",
    "framework": "TailwindCSS",
    "name": "Formulaire de contact",
    "description": "Formulaire de contact classique (nom, e-mail, message, bouton).",
    "keywords": ["contact", "formulaire", "message", "email", "form"],
    "sectors": ["Services", "Commerciale", "Alimentation"],
    "html_code": "<form class='space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm'> <h3 class='text-lg font-semibold text-slate-900'>{{HEADING}}</h3> <div> <label class='block text-sm font-medium text-slate-700'>{{NAME_LABEL}}</label> <input type='text' placeholder='{{NAME_PLACEHOLDER}}' class='mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 outline-none focus:border-blue-500' /> </div> <div> <label class='block text-sm font-medium text-slate-700'>{{EMAIL_LABEL}}</label> <input type='email' placeholder='{{EMAIL_PLACEHOLDER}}' class='mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 outline-none focus:border-blue-500' /> </div> <div> <label class='block text-sm font-medium text-slate-700'>{{MESSAGE_LABEL}}</label> <textarea rows='3' placeholder='{{MESSAGE_PLACEHOLDER}}' class='mt-1 w-full resize-none rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 outline-none focus:border-blue-500'></textarea> </div> <button type='submit' class='w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700'>{{SUBMIT_LABEL}}</button> </form>",
    "variables_attendues": [
      "heading",
      "name_label",
      "name_placeholder",
      "email_label",
      "email_placeholder",
      "message_label",
      "message_placeholder",
      "submit_label"
    ]
  },
  {
    "id": "booking-form",
    "category": "form",
