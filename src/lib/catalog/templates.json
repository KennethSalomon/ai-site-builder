    "sectors": ["Mode", "Electronique", "Alimentation"],
    "html_code": "<article class='overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm'> <div class='relative h-40 w-full bg-slate-100'> <img src='{{IMAGE_URL}}' alt='{{TITLE}}' class='h-full w-full object-cover' /> <span class='absolute left-3 top-3 rounded-full px-2 py-0.5 text-xs font-medium {{BADGE_CLASS}}'>{{BADGE}}</span> </div> <div class='p-4'> <h3 class='text-sm font-semibold text-slate-900'>{{TITLE}}</h3> <p class='mt-1 line-clamp-2 text-xs text-slate-500'>{{DESCRIPTION}}</p> <div class='mt-3 flex items-center justify-between'> <span class='text-lg font-bold text-slate-900'>{{PRICE}}</span> <button type='button' class='rounded-lg bg-blue-600 px-3 py-2 text-xs font-semibold text-white hover:bg-blue-700'>{{CTA}}</button> </div> </div> </article>",
    "variables_attendues": [
      "image_url",
      "title",
      "description",
      "price",
      "badge",
      "badge_class",
      "cta"
    ]
  },
