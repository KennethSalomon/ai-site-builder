    "sectors": ["Médecine", "Beauté", "Services"],
    "html_code": "<form class='space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm'> <h3 class='text-lg font-semibold text-slate-900'>{{HEADING}}</h3> <div> <label class='block text-sm font-medium text-slate-700'>{{SERVICE_LABEL}}</label> <select class='mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 outline-none focus:border-blue-500'> <option>{{SERVICE_OPTION}}</option> </select> </div> <div> <label class='block text-sm font-medium text-slate-700'>{{DATE_LABEL}}</label> <input type='date' class='mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 outline-none focus:border-blue-500' /> </div> <div> <label class='block text-sm font-medium text-slate-700'>{{PHONE_LABEL}}</label> <input type='tel' placeholder='{{PHONE_PLACEHOLDER}}' class='mt-1 w-full rounded-lg border border-slate-300 px-3 py-2 text-sm text-slate-900 outline-none focus:border-blue-500' /> </div> <button type='submit' class='w-full rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-blue-700'>{{SUBMIT_LABEL}}</button> </form>",
    "variables_attendues": [
      "heading",
      "service_label",
      "service_option",
      "date_label",
      "phone_label",
      "phone_placeholder",
      "submit_label"
    ]
  },
  {
    "id": "product-card",
    "category": "product",
    "framework": "TailwindCSS",
    "name": "Carte produit",
