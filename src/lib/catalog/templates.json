    "variables_attendues": ["label", "percent", "detail"]
  },
  {
    "id": "activity-row",
    "category": "dashboard_module",
    "framework": "TailwindCSS",
    "name": "Ligne d'activité",
    "description": "Élément de liste d'activité récente avec statut et horodatage.",
